# Environment variables for production deployment
# Copy this file to .env and update with your actual values

# Flask secret key - generate a strong random key
SECRET_KEY=

# Database connection string
# For SQLite: sqlite:///app.db
# For PostgreSQL: postgresql://username:password@localhost/dbname
DATABASE_URL=sqlite:///app.db

# Admin credentials: set each value in your local environment or deployment secrets
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional contact info exposed to templates via context processor
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_LINKEDIN=

# Optional automatic public social feed sync (set secrets in Railway Variables)
# LinkedIn requires an approved r_member_social application permission.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:replace-with-member-id
LINKEDIN_API_VERSION=202610
# Instagram requires an authorized professional account token with media-read access.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v25.0

# Email configuration (if using email features)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# File upload settings
MAX_FILE_SIZE=16777216  # 16MB in bytes
